# Site institucional da MD (mdsolucoes.eng.br). O Railway entrega HTTPS e o domínio; aqui é só HTTP na $PORT.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Domínio raiz e www servem o mesmo site; o raiz manda para o www (um endereço só para buscadores).
	@raiz host mdsolucoes.eng.br
	redir @raiz https://www.mdsolucoes.eng.br{uri} permanent

	# Atalhos para o portal do cliente.
	@hub path /hub /hub/* /entrar /login
	redir @hub {$SITE_HUB_URL:https://nexopulse.mdsolucoes.eng.br} temporary

	# Partes internas das páginas (o rodapé) não são servidas sozinhas.
	@interno path /_*
	respond @interno 404

	# Contato, CNPJ e endereço do Hub vêm das variáveis do Railway (SITE_WHATSAPP, SITE_EMAIL, SITE_CNPJ, SITE_CIDADE, SITE_HUB_URL).
	@paginas path / *.html
	templates @paginas

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
	}
	@estaticos path /img/* /fontes/*
	header @estaticos Cache-Control "public, max-age=604800"
	header @paginas Cache-Control "no-cache"

	try_files {path} {path}.html /index.html
	file_server
	handle_errors {
		rewrite * /index.html
		file_server
	}
}
